+    private static bool IsCompleteHtmlDocument(string html)
+    {
+        if (string.IsNullOrWhiteSpace(html))
+        {
+            return false;
+        }
+
+        int htmlIndex = html.IndexOf("<html", StringComparison.OrdinalIgnoreCase);
+        if (htmlIndex < 0)
+        {
+            return false;
+        }
+
+        string prefix = html[..htmlIndex].Trim();
+        return prefix.Length == 0 ||
+               prefix.StartsWith("<!doctype", StringComparison.OrdinalIgnoreCase) ||
+               prefix.StartsWith("<?xml", StringComparison.OrdinalIgnoreCase);
